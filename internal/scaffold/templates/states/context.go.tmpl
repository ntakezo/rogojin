package states

import (
{{- if .Proxy}}
	"context"
{{- end}}
{{- if .Output}}
	"encoding/json"
{{- end}}
{{- if .Proxy}}
	"fmt"
	"net/http"
	"net/url"

	"github.com/ntakezo/rogojin/proxies"
{{- end}}
	"github.com/ntakezo/rogojin/workflows"
)

// Input is the immutable per-task input the caller supplies at CreateTask. Add
// the fields your workflow needs; they must round-trip through JSON, since the
// module records the input in the snapshot envelope and rebuilds recovered
// contexts from it.
type Input struct {
	URL string `json:"url"`
}

{{- if .Output}}

// Result is the workflow's output, set by the terminal state and marshaled by
// Output on clean completion. Shape it to whatever your workflow produces.
type Result struct {
	URL   string `json:"url"`
	Bytes int    `json:"bytes"`
}
{{- end}}
{{- if .Durable}}

// Durable is the state the workflow accumulates as it advances, partitioned by
// the state that writes each section — so a later state reading an earlier
// one's output names the dependency. It is registered with Persist, so the
// snapshot envelope carries it and recovery restores it.
type Durable struct {
	Fetch FetchState `json:"fetch"`
}

// FetchState is what Fetch stores for the states after it.
type FetchState struct {
	Body string `json:"body"`
}
{{- end}}
{{- if .Proxy}}

// resources holds the per-run side effects: the proxy lease and the client
// built over it. They are acquired lazily on first use and rebuilt the same
// way after recovery — never serialized.
type resources struct {
	lease  *proxies.Lease
	client *http.Client
}
{{- end}}

// Context is the receiver shared across every state: the framework machinery
// (workflows.Base: deps, effect log, snapshot envelope), the immutable input,
// and the workflow's own state — each in its own zone.
type Context struct {
	workflows.Base
{{- if .Proxy}}

	proxies *proxies.Manager
{{- end}}

	in Input
{{- if .Durable}}
	d  Durable
{{- else}}
	body string
{{- end}}
{{- if .Proxy}}
	res resources
{{- end}}
{{- if .Output}}

	result Result
{{- end}}
}

// NewContext builds a context for one task; the module binds Base afterward.
{{- if .Durable}}
// Persist registers the durable state with the snapshot envelope.
{{- end}}
func NewContext(in Input{{if .Proxy}}, manager *proxies.Manager{{end}}) *Context {
	c := &Context{in: in{{if .Proxy}}, proxies: manager{{end}}}
{{- if .Durable}}
	c.Persist(&c.d)
{{- end}}
	return c
}
{{if .Output}}
// Output marshals the workflow's result to JSON. The engine reads it only on
// clean completion; a run that is killed or errors produces none.
func (c *Context) Output() ([]byte, error) {
	return json.Marshal(c.result)
}
{{end}}
{{- if .Proxy}}
// client leases a proxy and builds the HTTP client on first use, so a recovered
// task acquires its own lease wherever in the graph it resumes.
func (c *Context) client(ctx context.Context) (*http.Client, error) {
	if c.res.client != nil {
		return c.res.client, nil
	}
	placement := c.Assignment(proxies.Kind)
	if placement.GroupID == "" {
		return nil, fmt.Errorf("task %s has no proxy group assigned", c.TaskID())
	}
	lease, err := c.proxies.Acquire(ctx, proxies.Assignment{
		TaskID: c.TaskID(), GroupID: placement.GroupID, ResourceID: placement.ResourceID,
	})
	if err != nil {
		// A pin that no longer resolves is the fallback decision point: this
		// scaffold refuses, but returning an unproxied client here would run the
		// task naked instead.
		return nil, fmt.Errorf("acquire proxy: %w", err)
	}
	proxyURL, err := url.Parse(lease.Resource().URL)
	if err != nil {
		lease.ReleaseOutcome(ctx, false)
		return nil, fmt.Errorf("parse proxy url: %w", err)
	}
	c.res.lease = lease
	c.res.client = &http.Client{Transport: &http.Transport{Proxy: http.ProxyURL(proxyURL)}}
	return c.res.client, nil
}

// Teardown releases the task's proxy lease exactly once when the run exits,
// reporting the outcome its selection learns from — success being the absence
// of a run error.
func (c *Context) Teardown(ctx context.Context, status workflows.Status, runErr error) error {
	if c.res.lease == nil {
		return nil
	}
	return c.res.lease.ReleaseOutcome(ctx, runErr == nil)
}
{{end}}
