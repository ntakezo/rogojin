package states

import (
	"time"

	"github.com/ntakezo/rogojin/workflows"
)

// Each state's name lives next to the others; the handler for each is a method
// on Context, wired below.
const (
	fetch   workflows.State = "fetch"
	process workflows.State = "process"
)

// Graph wires the states into a workflow graph bound to this context. Each
// handler is a method value closing over c, so state flows through the
// receiver rather than a threaded argument. Cross-cutting policy — retries,
// timeouts — is declared here, not in handler bodies: workflows.Retry,
// workflows.Timeout, and friends wrap the handler at graph build.
func (c *Context) Graph() workflows.Graph {
	return workflows.NewGraph(fetch,
		workflows.On(fetch, c.Fetch,
			workflows.Retry(3, workflows.ExpBackoff(500*time.Millisecond, 2, 5*time.Second))),
		workflows.On(process, c.Process),
	)
}
