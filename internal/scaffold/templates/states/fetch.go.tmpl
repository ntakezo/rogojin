package states

import (
	"context"
	"io"

	"github.com/ntakezo/rogojin/workflows"
{{- if not .Proxy}}
	"{{.ModulePath}}/{{.Package}}/common"
{{- end}}
	"{{.ModulePath}}/{{.Package}}/requests"
)

// Fetch retrieves the input URL through a request function and stores the body
// for the next state. It is the graph's initial state; the graph retries it
// with backoff, so a transient network failure re-runs the whole handler.
func (c *Context) Fetch(ctx context.Context) (*workflows.State, error) {
{{- if .Proxy}}
	client, err := c.client(ctx)
	if err != nil {
		return nil, err
	}
{{- else}}
	client, err := common.NewClient("")
	if err != nil {
		return nil, err
	}
{{- end}}
	res, err := requests.GetPage(ctx, client, requests.GetPageRequest{URL: c.in.URL})
	if err != nil {
		return nil, err
	}
	defer res.Body.Close()
	// The starter target returns HTML, so read the body raw. For a JSON
	// endpoint, json.Unmarshal it into a requests.GetPageResponse instead.
	body, err := io.ReadAll(res.Body)
	if err != nil {
		return nil, err
	}
{{- if .Durable}}
	c.d.Fetch.Body = string(body)
{{- else}}
	c.body = string(body)
{{- end}}
	return workflows.Next(process), nil
}
