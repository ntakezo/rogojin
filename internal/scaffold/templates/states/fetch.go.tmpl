package states

import (
	"context"
	"encoding/json"

	"github.com/ntakezo/rogojin/workflows"
	"{{.ModulePath}}/{{.Package}}/requests"
)

// Fetch calls the fetch request and records how the server saw us. It is the
// graph's initial state.
func (c *Context) Fetch(ctx context.Context) (*workflows.State, error) {
	client, err := c.client(ctx)
	if err != nil {
		return nil, err
	}

	res, err := requests.Fetch(ctx, client, requests.FetchRequest{URL: c.input.URL})
	if err != nil {
		return nil, err
	}
	defer res.Body.Close()

	var body requests.FetchResponse
	if err := json.NewDecoder(res.Body).Decode(&body); err != nil {
		return nil, err
	}
	c.r.ip = body.IP
	c.r.httpVersion = body.HTTPVersion

	return workflows.Next(process), nil
}
