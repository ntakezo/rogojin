package states

import (
	"context"
	"fmt"

	"github.com/ntakezo/rogojin/workflows"
)

// Process handles the fetched body and completes the task by returning a nil
// next state. Replace the body with your own terminal logic, or return
// workflows.Next(someState) to advance to another state instead.
//
// Handlers run at least once: recovery re-enters the state that was in
// flight, and a graph Retry re-runs it. A side effect a re-run must not
// repeat rides in workflows.Do (or c.Once), whose effect log records the
// success durably and replays it instead of repeating it.
func (c *Context) Process(ctx context.Context) (*workflows.State, error) {
{{- if .Durable}}
	fmt.Printf("fetched %d bytes from %s\n", len(c.d.Fetch.Body), c.in.URL)
{{- else}}
	fmt.Printf("fetched %d bytes from %s\n", len(c.body), c.in.URL)
{{- end}}
{{- if .Output}}
{{- if .Durable}}
	c.result = Result{URL: c.in.URL, Bytes: len(c.d.Fetch.Body)}
{{- else}}
	c.result = Result{URL: c.in.URL, Bytes: len(c.body)}
{{- end}}
{{- end}}
	return nil, nil
}
