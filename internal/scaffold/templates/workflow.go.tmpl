// Package {{.Package}} is a generated rogojin workflow. The module here is
// declarative — one build function derives validation, construction, and
// snapshot recovery — and the actual automation lives in the states
// subpackage, where each state is a method you edit.
package {{.Package}}

import (
	"{{.ModulePath}}/{{.Package}}/states"
{{- if .Proxy}}
	"github.com/ntakezo/rogojin/leasing"
	"github.com/ntakezo/rogojin/proxies"
{{- end}}
	"github.com/ntakezo/rogojin/workflows"
)

// Name is the ID the workflow registers under and tasks are created from.
const Name = "{{.Name}}"

// New builds the workflow module. Instances embed workflows.Base, so the
// module binds each task's deps into them and restores snapshots without
// hand-written plumbing.{{if .Output}} The module declares states.Result as its output, so
// tasks.Create returns a handle typed to it.{{end}}{{if .Proxy}} The proxy manager arrives through
// WithResources at registration — from the task manager's own registry, so
// the manager a task leases through is the same instance the task manager
// unlocks through; a missing or mistyped kind fails the registration at
// boot.{{end}}
func New() {{if .Output}}*workflows.OutModule[states.Input, states.Result]{{else}}workflows.Workflow{{end}} {
{{- if .Proxy}}
	var manager *proxies.Manager
{{- end}}
	return workflows.NewModule(Name,
		func(in states.Input, deps workflows.Deps) (workflows.Instance, error) {
			return states.NewContext(in{{if .Proxy}}, manager{{end}}), nil
		}){{if .Proxy}}.
		WithResources(func(managers map[leasing.Kind]any) error {
			var err error
			manager, err = workflows.Resource[*proxies.Manager](managers, proxies.Kind)
			return err
		}){{end}}{{if .Output}}.
		Returns[states.Result](){{end}}
}
