// Command run wires the {{.Name}} workflow onto a task service and runs one
// task end to end. It is a starting point — edit the input, swap the
// repositories, and grow the inventory to taste.
package main

import (
	"context"
{{- if and (not .Persist) (or .Accounts .Payments)}}
	"encoding/json"
{{- end}}
{{- if .Persist}}
	"flag"
{{- end}}
	"log"
	"os"

	"github.com/ntakezo/rogojin/comms"
{{- if .Accounts}}
	"github.com/ntakezo/rogojin/accounts"
{{- end}}
{{- if .Email}}
	"github.com/ntakezo/rogojin/email"
{{- end}}
{{- if and (not .Persist) (or .Proxy .Accounts .Payments)}}
	"github.com/ntakezo/rogojin/leasing"
{{- end}}
{{- if .Payments}}
	"github.com/ntakezo/rogojin/payments"
{{- end}}
{{- if .Proxy}}
	"github.com/ntakezo/rogojin/proxies"
{{- end}}
{{- if .Persist}}
	"github.com/ntakezo/rogojin/{{.RepoPkg}}"
{{- end}}
	"github.com/ntakezo/rogojin/tasks"
	"{{.ModulePath}}/{{.Package}}"
	"{{.ModulePath}}/{{.Package}}/states"
)

func main() {
	ctx := context.Background()

{{- if .Persist}}

	// One database holds every store — tasks and inventory alike: each store
	// records its migrations under its own name in a shared ledger. The
	// inventory seeded below persists across runs, so grow it once and it
	// stays. Every process pointed at the same database is a node of the same
	// fleet: claims, leases, and locks coordinate them through the store.
	dsn := flag.String("db", "{{.DBDefault}}", "database the fleet shares")
	flag.Parse()
	db, err := {{.RepoPkg}}.Open(*dsn)
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close()
{{- else}}

	// Every repository below is nil: the managers run purely in memory, so
	// nothing — inventory, locks, task history — survives the process. Swap
	// in the sqlite or postgres constructors for durability.
{{- end}}

{{- if .Email}}

	// Email is not a leased resource — no groups, no rotation, no locks. The
	// inventory holds the inboxes tasks listen to.
{{- if .Persist}}
	emailRepo, err := {{.RepoPkg}}.NewEmails(db)
	if err != nil {
		log.Fatal(err)
	}
	emailManager, err := email.NewManager(ctx, emailRepo)
{{- else}}
	emailManager, err := email.NewManager(ctx, nil)
{{- end}}
	if err != nil {
		log.Fatal(err)
	}
	defer emailManager.Close()
{{- if not .Persist}}
	if err := emailManager.Add(ctx, email.Email{
		ID:      "inbox-1", // replace with a real inbox
		Address: "you@example.com",
		Inbox:   &email.Inbox{Vendor: email.Gmail, Auth: email.Auth{Kind: email.AuthPassword, Password: "app-password"}},
	}); err != nil {
		log.Fatal(err)
	}
{{- end}}
{{- end}}

{{- if .Proxy}}

{{- if .Persist}}
	proxyRepo, err := {{.RepoPkg}}.NewProxies(db)
	if err != nil {
		log.Fatal(err)
	}
	proxyManager, err := proxies.NewManager(ctx, proxyRepo)
{{- else}}
	proxyManager, err := proxies.NewManager(ctx, nil)
{{- end}}
	if err != nil {
		log.Fatal(err)
	}
	defer proxyManager.Close()
{{- if not .Persist}}
	if err := proxyManager.Add(ctx, proxies.Proxy{
		Resource: leasing.Resource{ID: "proxy-1"}, // replace with real proxies
		URL:      "http://127.0.0.1:8080",
	}); err != nil {
		log.Fatal(err)
	}
{{- end}}
{{- end}}

{{- if .Accounts}}

{{- if .Persist}}
	accountRepo, err := {{.RepoPkg}}.NewAccounts(db)
	if err != nil {
		log.Fatal(err)
	}
	accountManager, err := accounts.NewManager(ctx, accountRepo{{if .Email}}, accounts.WithEmail(emailManager){{end}})
{{- else}}
	accountManager, err := accounts.NewManager(ctx, nil{{if .Email}}, accounts.WithEmail(emailManager){{end}})
{{- end}}
	if err != nil {
		log.Fatal(err)
	}
	defer accountManager.Close()
{{- if not .Persist}}
	if err := accountManager.Add(ctx, accounts.Account{
		Resource: leasing.Resource{ID: "account-1"}, // replace with real accounts
{{- if .Email}}
		EmailID:  "inbox-1", // this account's forwarding inbox
{{- end}}
		Fields: json.RawMessage(`{"email":"you@example.com","name":"Sample Buyer","address":"1 Example St"}`),
	}); err != nil {
		log.Fatal(err)
	}
{{- end}}
{{- end}}

{{- if .Payments}}

{{- if .Persist}}
	paymentRepo, err := {{.RepoPkg}}.NewPayments(db)
	if err != nil {
		log.Fatal(err)
	}
	paymentManager, err := payments.NewManager(ctx, paymentRepo)
{{- else}}
	paymentManager, err := payments.NewManager(ctx, nil)
{{- end}}
	if err != nil {
		log.Fatal(err)
	}
	defer paymentManager.Close()
{{- if not .Persist}}
	if err := paymentManager.Add(ctx, payments.Payment{
		Resource: leasing.Resource{ID: "payment-1"}, // replace with real instruments
		Fields:   json.RawMessage(`{"number":"4242424242424242","expiry":"12/30","cvv":"123"}`),
	}); err != nil {
		log.Fatal(err)
	}
{{- end}}
{{- end}}

{{- if .Persist}}

	repo, err := {{.RepoPkg}}.NewTasks(db)
	if err != nil {
		log.Fatal(err)
	}
{{- end}}
{{- if or .Proxy .Accounts .Payments}}
	// Leases and locks outlive the process, so each manager registers under
	// its kind: deleting a task frees its locks, and repointing one drops the
	// lock its new placement no longer fits. This is each manager's one entry
	// point: RegisterWorkflow hands them to the workflow through UseResources,
	// so the instance a task leases through is the instance a deletion
	// unlocks through.
{{- end}}
	opts := []tasks.Option{
{{- if .Proxy}}
		tasks.WithResource(proxies.Kind, proxyManager),
{{- end}}
{{- if .Accounts}}
		tasks.WithResource(accounts.Kind, accountManager),
{{- end}}
{{- if .Payments}}
		tasks.WithResource(payments.Kind, paymentManager),
{{- end}}
	}
	// A node id names this process in the store's task claims. The default is
	// unique per process; set ROGOJIN_NODE to pin a stable name per machine.
	if node := os.Getenv("ROGOJIN_NODE"); node != "" {
		opts = append(opts, tasks.WithNode(node))
	}
	svc, err := tasks.NewManager(ctx, {{if .Persist}}repo{{else}}nil{{end}}, comms.NewBus(), opts...)
	if err != nil {
		log.Fatal(err)
	}
	defer svc.Close()

	wf := {{.Package}}.New({{if .Email}}emailManager{{end}})
	if err := svc.RegisterWorkflow({{.Package}}.Name, wf); err != nil {
		log.Fatal(err)
	}

	// Creating against the module infers the input and output types, so the
	// task handle's Start returns a decoded states.Result.
	task, err := tasks.Create(ctx, svc, wf, states.Input{URL: "https://example.com"{{if and .Email (not .Accounts)}}, EmailID: "inbox-1"{{end}}}{{if .Proxy}},
		tasks.WithResourceGroup(proxies.Kind, proxies.GlobalGroup){{end}}{{if .Accounts}},
		tasks.WithResourceGroup(accounts.Kind, accounts.GlobalGroup){{end}}{{if .Payments}},
		tasks.WithResourceGroup(payments.Kind, payments.GlobalGroup){{end}})
	if err != nil {
		log.Fatal(err)
	}
	result, err := task.Start(ctx)
	if err != nil {
		log.Fatal(err)
	}
	log.Printf("task %s finished with status %q, fetched %d bytes from %s", task.ID, task.Status, result.Bytes, result.URL)
}
