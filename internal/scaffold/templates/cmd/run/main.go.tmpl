// Command run wires the {{.Name}} workflow onto a task service and runs one
// task end to end. It is a starting point — edit the input, swap the
// persistence, and add proxies to taste.
package main

import (
	"context"
	"log"
{{- if .Proxy}}{{if not .ProxyPersist}}
	"sync"
{{- end}}{{end}}

	"github.com/ntakezo/rogojin/comms"
{{- if .Proxy}}{{if not .ProxyPersist}}
	"github.com/ntakezo/rogojin/leasing"
{{- end}}{{end}}
{{- if .Proxy}}
	"github.com/ntakezo/rogojin/proxies"
{{- end}}
{{- if or .TaskPersist .ProxyPersist}}
	"github.com/ntakezo/rogojin/sqlite"
{{- end}}
	"github.com/ntakezo/rogojin/tasks"
	"{{.ModulePath}}/{{.Package}}"
	"{{.ModulePath}}/{{.Package}}/states"
)

func main() {
	ctx := context.Background()

{{- if or .TaskPersist .ProxyPersist}}

{{- if and .TaskPersist .ProxyPersist}}
	// One database holds both the proxy pool and the task history: every store
	// records its migrations under its own name in a shared ledger. Open a
	// second file if you would rather keep them apart.
{{- end}}
	db, err := sqlite.Open("{{.Package}}.db")
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close()
{{- end}}

{{- if .Proxy}}

{{- if .ProxyPersist}}
	proxyRepo, err := sqlite.NewProxies(db)
	if err != nil {
		log.Fatal(err)
	}
{{- else}}

	// An in-memory proxy pool to get started. Seed it with real proxies, or
	// swap in sqlite.NewProxies for a durable pool.
	proxyRepo := newMemProxyRepo(
		proxies.Proxy{Resource: leasing.Resource{ID: "proxy-1"}, URL: "http://127.0.0.1:8080"},
	)
{{- end}}

	manager, err := proxies.NewManager(ctx, proxyRepo)
	if err != nil {
		log.Fatal(err)
	}
{{- end}}

{{- if .TaskPersist}}

	repo, err := sqlite.NewTasks(db)
	if err != nil {
		log.Fatal(err)
	}
{{- else}}

	// A nil task repository runs tasks purely in memory: no checkpoints, no
	// recovery. Swap in sqlite.NewTasks (or your own Repository) for durability.
{{- end}}
{{- if .Proxy}}
	// Proxy locks outlive the process, so the manager registers under its kind:
	// deleting a task frees its lock, and repointing one drops the lock its new
	// placement no longer fits. Nothing else ever clears them. Add a second kind
	// the same way. This is the manager's one entry point: RegisterWorkflow
	// hands it to the workflow through UseResources, so the instance a task
	// leases through is the instance a deletion unlocks through.
	svc, err := tasks.NewManager(ctx, {{if .TaskPersist}}repo{{else}}nil{{end}}, comms.NewBus(),
		tasks.WithResource(proxies.Kind, manager))
	if err != nil {
		log.Fatal(err)
	}

	if err := svc.RegisterWorkflow({{.Package}}.Name, {{.Package}}.New()); err != nil {
		log.Fatal(err)
	}
{{- else}}
	svc, err := tasks.NewManager(ctx, {{if .TaskPersist}}repo{{else}}nil{{end}}, comms.NewBus())
	if err != nil {
		log.Fatal(err)
	}

	if err := svc.RegisterWorkflow({{.Package}}.Name, {{.Package}}.New()); err != nil {
		log.Fatal(err)
	}
{{- end}}

	task, err := svc.CreateTask(ctx, {{.Package}}.Name, states.Input{URL: "https://example.com"}{{if .Proxy}}, tasks.WithResourceGroup(proxies.Kind, proxies.GlobalGroup){{end}})
	if err != nil {
		log.Fatal(err)
	}
{{- if .Output}}
	output, err := task.Start(ctx)
	if err != nil {
		log.Fatal(err)
	}
	log.Printf("task %s finished with status %q, output %s", task.ID, task.Status, output)
{{- else}}
	if _, err := task.Start(ctx); err != nil {
		log.Fatal(err)
	}
	log.Printf("task %s finished with status %q", task.ID, task.Status)
{{- end}}
}
{{if and .Proxy (not .ProxyPersist)}}
// memProxyRepo is a minimal in-memory proxies.Repository: a dumb store of the
// seeded pool. The Manager owns all live lease state, so this only holds records.
type memProxyRepo struct {
	mu      sync.Mutex
	records map[string]proxies.Proxy
	order   []string
	groups  map[string]proxies.Group
}

func newMemProxyRepo(seed ...proxies.Proxy) *memProxyRepo {
	r := &memProxyRepo{records: make(map[string]proxies.Proxy), groups: make(map[string]proxies.Group)}
	for _, p := range seed {
		r.records[p.ID] = p
		r.order = append(r.order, p.ID)
	}
	return r
}

func (r *memProxyRepo) List(ctx context.Context) ([]proxies.Proxy, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	out := make([]proxies.Proxy, 0, len(r.order))
	for _, id := range r.order {
		if p, ok := r.records[id]; ok {
			out = append(out, p)
		}
	}
	return out, nil
}

func (r *memProxyRepo) Save(ctx context.Context, p proxies.Proxy) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.records[p.ID]; !ok {
		r.order = append(r.order, p.ID)
	}
	r.records[p.ID] = p
	return nil
}

func (r *memProxyRepo) Delete(ctx context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	delete(r.records, id)
	return nil
}

func (r *memProxyRepo) ListGroups(ctx context.Context) ([]proxies.Group, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	out := make([]proxies.Group, 0, len(r.groups))
	for _, g := range r.groups {
		out = append(out, g)
	}
	return out, nil
}

func (r *memProxyRepo) SaveGroup(ctx context.Context, g proxies.Group) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.groups[g.ID] = g
	return nil
}

func (r *memProxyRepo) DeleteGroup(ctx context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	delete(r.groups, id)
	return nil
}
{{end}}
